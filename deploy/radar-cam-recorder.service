[Unit]
Description=Camera + LD2451 radar recorder
After=local-fs.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
User=bmendonca
WorkingDirectory=/home/bmendonca/workspace/radar-cam-recorder
ExecStart=/home/bmendonca/workspace/radar-cam-recorder/.venv/bin/radar-cam-recorder run --config /etc/radar-cam-recorder.toml
ExecStopPost=/home/bmendonca/workspace/radar-cam-recorder/deploy/rcr-leds-stop.sh
RuntimeDirectory=radar-cam-recorder
# Keep the status file across restarts (Restart=always) so `status` always has one.
RuntimeDirectoryPreserve=yes
KillSignal=SIGTERM
# Only the recorder gets SIGTERM; it stops rpicam-vid itself with SIGINT so the
# video file is finalised. Leftovers are SIGKILLed after TimeoutStopSec.
KillMode=mixed
TimeoutStopSec=15
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
